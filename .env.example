# ==========================================================
# MoneyMate — example environment file
# Copy to .env and fill in your own values. Never commit .env.
# ==========================================================

SECRET_KEY=your-django-secret-key
DEBUG=True

# Gmail SMTP (Google App Password — generated at
# https://myaccount.google.com/apppasswords with 2FA enabled)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gemini AI
# GEMINI_API_KEY = your-gemini-api-key
# Model used for chat, insights and memory (any flash model your key can call)
# GEMINI_MODEL=gemini-3.8-flash
